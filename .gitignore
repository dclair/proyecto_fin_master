# ==============================================================================
# .gitignore - Aficionados Network (Producción Segura)
# ==============================================================================

# Variables de entorno y secretos
.env
.env.*
!.env.example
!.env.prod.example

# Volcados de base de datos y copias de seguridad
*.sqlite3
*.sqlite3-journal
*.sqlite3.backup
*.sql
*.sql.gz
backup_*.json
backup_*.sql
backup_db.json
db_full_backup.json

# Cookies y credenciales de sesión / depuración
cookies.txt
chat_debug.log
*.log
celerybeat-schedule*

# Scripts temporales / scratch de desarrollo
test_hide.py

# Entornos virtuales locales
env/
venv/
.venv/
ENV/

# Python cache y compilados
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Archivos estáticos y multimedia generados
staticfiles/
media/

# Node / Frontend dependencias y builds locales
frontend/node_modules/
frontend/dist/
frontend/.vite/
package-analysis.md

# Documentación interna y temporales
Proyecto_Final_Docs_varios/
*.odt
*.docx
.DS_Store
Thumbs.db
