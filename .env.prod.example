# ==============================================================================
# .env.prod.example - Configuración de Producción
# Copia este archivo a .env.prod en el servidor y define valores seguros
# ==============================================================================

DEBUG=False
# Generar con: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=genera-una-clave-aleatoria-y-larga-para-produccion

# Host y orígenes confiables (IP o dominio con HTTPS)
ALLOWED_HOSTS=tudominio.com,tu_ip_publica
CSRF_TRUSTED_ORIGINS=https://tudominio.com,http://tu_ip_publica,http://tu_ip_publica:8000,http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000
SITE_ID=1

# Base de datos (MariaDB / MySQL en Docker)
DB_ENGINE=mysql
DB_NAME=aficionados_network_db
DB_USER=django_user
DB_PASSWORD=genera-un-password-fuerte-para-la-bd
DB_ROOT_PASSWORD=genera-un-password-fuerte-para-root
DB_HOST=db
DB_PORT=3306
DB_CONN_MAX_AGE=600

# Redis (Django Channels / Celery)
REDIS_URL=redis://redis:6379/0

# Seguridad HTTPS y Cookies (Activar True una vez instalado el certificado SSL/TLS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Servidor de Correo (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo_corporativo@gmail.com
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion_google
DEFAULT_FROM_EMAIL=tu_correo_corporativo@gmail.com
CONTACT_EMAIL=tu_correo_corporativo@gmail.com

# Integraciones de IA
GEMINI_API_KEY=tu_gemini_api_key_produccion
