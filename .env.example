# ==============================================================================
# .env.example - Configuración de Desarrollo Local
# Copia este archivo a .env y rellena con tus valores locales
# ==============================================================================

DEBUG=True
SECRET_KEY=django-insecure-generate-a-secure-random-key-for-local-dev
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
SITE_ID=1

# Base de datos: sqlite o mysql
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# Para MariaDB/MySQL local (opcional):
# DB_ENGINE=mysql
# DB_NAME=aficionados_network_db
# DB_USER=django_user
# DB_PASSWORD=tu_password_local_seguro
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_CONN_MAX_AGE=600

# Redis (para Django Channels)
REDIS_URL=redis://127.0.0.1:6379/0

# Servidor de Correo (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_password_de_aplicacion_google
DEFAULT_FROM_EMAIL=tu_correo@gmail.com
CONTACT_EMAIL=tu_correo@gmail.com

# Integraciones de IA
GEMINI_API_KEY=tu_gemini_api_key_aqui
